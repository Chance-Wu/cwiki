# 行尾统一策略：索引与工作区一律 LF，消除 core.autocrlf=true 在 Windows 上的 CRLF 噪音
* text=auto eol=lf

# Windows 批处理脚本保持 CRLF，避免 cmd.exe 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.npz binary
*.npy binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pyc binary
